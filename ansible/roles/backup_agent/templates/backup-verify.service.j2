#jinja2: trim_blocks: True, lstrip_blocks: True
# {{ ansible_managed }}
[Unit]
Description=DR restore verification for {{ dr_project }}/{{ dr_environment }}
Documentation=file://{{ backup_agent_config_file }}

[Service]
Type=oneshot
ExecStart={{ backup_agent_verify_bin }}
Nice=15
IOSchedulingClass=idle

ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths={{ backup_agent_state_dir }} {{ dr_backup_target | regex_replace('^file://', '') }}

[Install]
WantedBy=multi-user.target
